# Copy to .env and fill in. Never commit .env (it is gitignored).

# ---- Required: API keys ----------------------------------------------------------------------
OPENAI_API_KEY=
# ElevenLabs key with the "Text to Speech" permission ("Voices: read" is optional)
ELEVENLABS_API_KEY=

# ---- Spending ---------------------------------------------------------------------------------
# Total USD the pipeline may spend, counted across runs in out/spend.log. A full edition with voice
# for 4 listeners costs about $4.50, so leave room for re-runs.
API_BUDGET_USD=25

# ---- Prices used for the cost report (check them against your own plans) ---------------------
# USD per 1M tokens (input / output), from the OpenAI pricing page
CHEAP_IN=0.25
CHEAP_OUT=2.00
LARGE_IN=1.25
LARGE_OUT=10.00
EMBED_IN=0.02
# USD per 1,000 characters of voice (your ElevenLabs plan rate)
TTS_PER_1K_CHARS=0.18
# USD per minute of transcribed voice requests
TRANSCRIBE_PER_MIN=0.003

# ---- Models (check the names against your OpenAI account's model list) -----------------------
CHEAP_MODEL=gpt-5-mini
LARGE_MODEL=gpt-5
EMBED_MODEL=text-embedding-3-small
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Reasoning effort per model; set to empty for non-reasoning models
CHEAP_REASONING=low
LARGE_REASONING=medium
# Seconds before an OpenAI call times out (scripts can take a few minutes)
OPENAI_TIMEOUT=600

# ---- Voice ------------------------------------------------------------------------------------
# Default voice (George, an ElevenLabs pre-made voice); listeners can pick others in the app
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
TTS_MODEL=eleven_v4

# ---- Optional tuning --------------------------------------------------------------------------
# Articles at least this similar are the same story; borderline pairs down to CLUSTER_CONFIRM_LOW
# are checked by the small model (set CLUSTER_CONFIRM=0 to switch that off)
CLUSTER_THRESHOLD=0.78
CLUSTER_CONFIRM=1
CLUSTER_CONFIRM_LOW=0.62
# Port for python server.py
PORT=8000
# Models for the build-time worker and critic agents (agents/run_agents.py)
AGENT_WORKER_MODEL=gpt-5
AGENT_CRITIC_MODEL=gpt-5
