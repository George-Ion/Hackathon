# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Pre-made voice id (George). Voice Library voices need a paid plan.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Model choices: cheap model for bulk steps, large model only for writing the script.
# Check these names against your OpenAI account's model list.
CHEAP_MODEL=gpt-5-mini
LARGE_MODEL=gpt-5
EMBED_MODEL=text-embedding-3-small

# USD per 1M tokens (input/output) - update from the OpenAI pricing page
CHEAP_IN=0.25
CHEAP_OUT=2.00
LARGE_IN=1.25
LARGE_OUT=10.00
EMBED_IN=0.02
# USD per 1K characters of TTS (check your ElevenLabs plan)
TTS_PER_1K_CHARS=0.18
API_BUDGET_USD=5.00
